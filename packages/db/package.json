{
  "name": "@crm/db",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "validate": "prisma validate",
    "typecheck": "node scripts/validate.mjs && tsc --noEmit",
    "test": "vitest run",
    "build": "prisma generate && tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/node": "^22.0.0",
    "pglite-prisma-adapter": "^0.6.1",
    "prisma": "^6.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@crm/tsconfig": "workspace:*"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  }
}
