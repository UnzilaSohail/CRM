{
  "name": "ainetworks-crm",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @crm/db generate",
    "db:migrate": "pnpm --filter @crm/db migrate"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  }
}
