{
  "name": "@crm/api",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run && node --test \"tests/*.test.mjs\""
  },
  "dependencies": {
    "@crm/kpi-engine": "workspace:*",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-fastify": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "@crm/types": "workspace:*",
    "@crm/validators": "workspace:*",
    "@nestjs/swagger": "^7.4.2",
    "@fastify/static": "^7.0.4",
    "zod": "^3.23.8",
    "@crm/db": "workspace:*"
  },
  "devDependencies": {
    "@crm/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "@nestjs/testing": "^10.4.4",
    "@swc/core": "^1.7.35",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.3"
  }
}
